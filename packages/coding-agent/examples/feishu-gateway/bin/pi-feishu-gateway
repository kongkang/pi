#!/usr/bin/env bash
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
	link="$(readlink "$source_path")"
	if [[ "$link" = /* ]]; then
		source_path="$link"
	else
		source_path="$(cd "$(dirname "$source_path")" && pwd)/$link"
	fi
done
script_dir="$(cd "$(dirname "$source_path")" && pwd)"
gateway_dir="$(cd "$script_dir/.." && pwd)"
repo_root="$(cd "$gateway_dir/../../../.." && pwd)"

export PATH="$HOME/.local/bin:$PATH:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
	# shellcheck source=/dev/null
	. "$NVM_DIR/nvm.sh" --no-use
	required_node="$(<"$repo_root/.nvmrc")"
	if ! nvm use --silent "$required_node" >/dev/null; then
		echo "Node.js $required_node is not installed. Run 'nvm install' in $repo_root." >&2
		exit 1
	fi
fi

if ! command -v node >/dev/null 2>&1 || ! node --version >/dev/null 2>&1; then
	echo "Node.js is required" >&2
	exit 1
fi

exec node "$gateway_dir/gateway.ts" "$@"
